#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

RED='\033[0;31m'
BLACK='\033[1;30m' # Bright black/dark gray for visibility on dark backgrounds
BOLD='\033[1m'
NC='\033[0m'

CHECK="${RED}✔${NC}"
CROSS="${BLACK}✖${NC}"
INFO="${RED}➜${NC}"
WARN="${BLACK}⚠${NC}"

DYLIB="https://anc4cpypjs.ufs.sh/f/fuloy9zwEAJtetVQAkk2p8cUyCAwunYNKGtDbQeB7sFdxjqI"
RESOURCES="https://06adh2cq3g.ufs.sh/f/NVVNVT2YYGTKQ9rUdoV49skde02TIAqrfYGzPaElZgLUF7Jt"
UI="https://anc4cpypjs.ufs.sh/f/fuloy9zwEAJtvE7eVgbncYl7dhxBGyMKF3U4o50piQgtJDnX"

section() {
    echo
    echo -e "${BOLD}${RED}==> $1${NC}"
}

run_step() {
    local msg="$1"
    shift

    echo -ne "${BLACK}[...]${NC} $msg\r"

    if "$@"; then
        printf "\r\033[K${RED}${CHECK} %s${NC}\n" "$msg"
    else
        printf "\r\033[K${RED}${CROSS} %s${NC}\n" "$msg"
        exit 1
    fi
}

